APP_ENV=production
DATABASE_URL=sqlite:////opt/headachetrade/shared/data/headache_trade.sqlite3
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_INCLUDE_5M=false
FUTU_MARKET=US
FUTU_WATCHLIST_GROUP=
MARKET_FILTER_SYMBOLS=SPY,QQQ
PUBLIC_BASE_URL=http://127.0.0.1:8001
ENABLE_SIM_TRADING=true
ENABLE_REAL_TRADING=false
ENABLE_AUTO_APPROVAL=true
ENABLE_AUTO_SHORT=false
MAX_POSITIONS=1
RISK_PER_TRADE_PCT=0.005
MAX_SYMBOL_POSITION_PCT=0.4
MAX_SPREAD_PCT=0.002
MAX_DAILY_NEW_TRADES=3
MAX_DAILY_LOSS_PCT=0.015
MAX_CONSECUTIVE_LOSSES=3
ENTRY_ORDER_TIMEOUT_SECONDS=60
FORCE_INTRADAY_EXIT=true
ENABLE_OVERNIGHT_HOLD=false
NO_NEW_ENTRY_BEFORE_MINUTES_AFTER_OPEN=60
NO_NEW_ENTRY_BEFORE_CLOSE_MINUTES=30
