[Unit]
Description=HeadacheTradeV2 FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=headachetrade
Group=headachetrade
WorkingDirectory=/opt/headachetrade/current
EnvironmentFile=/etc/headachetrade/headachetrade.env
ExecStart=/opt/headachetrade/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

