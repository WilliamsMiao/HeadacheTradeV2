[Unit]
Description=Refresh HeadacheTradeV2 market baseline before the US market opens
After=network-online.target futu-opend.service
Wants=network-online.target

[Service]
Type=oneshot
User=headachetrade
Group=headachetrade
WorkingDirectory=/opt/headachetrade/current
EnvironmentFile=/etc/headachetrade/headachetrade.env
RuntimeDirectory=headachetrade
RuntimeDirectoryMode=0755
ExecStart=/opt/headachetrade/current/.venv/bin/python -m app.cli run-market-refresh
TimeoutStartSec=20min
