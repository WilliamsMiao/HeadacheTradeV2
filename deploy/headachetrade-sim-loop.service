[Unit]
Description=HeadacheTradeV2 automatic simulated trading loop
After=network-online.target futu-opend.service headachetrade.service
Wants=network-online.target

[Service]
Type=oneshot
User=headachetrade
Group=headachetrade
WorkingDirectory=/opt/headachetrade/current
EnvironmentFile=/etc/headachetrade/headachetrade.env
RuntimeDirectory=headachetrade
RuntimeDirectoryMode=0755
ExecStart=/opt/headachetrade/current/.venv/bin/python -m app.cli run-sim-loop
TimeoutStartSec=90s
